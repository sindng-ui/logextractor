{
  "name": "happytool-light",
  "private": true,
  "version": "1.5.5",
  "description": "HappyTool Light - High-Performance Log Analyzer",
  "author": {
    "name": "granular.sim",
    "email": "granular.sim@samsung.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:3000 && electron .\"",
    "electron:build": "node scripts/build-electron.js",
    "cli": "electron ./electron/cli.cjs",
    "test": "vitest"
  },
  "build": {
    "appId": "com.happytool.light",
    "productName": "HappyTool",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/public/wasm/*.wasm",
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "C:/Users/simja/AppData/Local/Temp/electron-build-out"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HappyTool",
      "uninstallDisplayName": "HappyTool",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@serialport/bindings-cpp": "^13.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dexie": "^4.3.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.554.0",
    "mime-types": "^2.1.35",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-virtuoso": "^4.18.1",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "^1.0.10",
    "recharts": "^3.7.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-virtualized-auto-sizer": "^1.0.5",
    "@types/react-window": "^1.8.8",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  }
}
